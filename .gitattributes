# Provenance hashes are SHA-256 over raw file bytes and are recorded in run
# manifests (results/*/manifest.json, qc.json). Pin line endings for JSON so
# any fresh checkout reproduces those hashes exactly, regardless of
# core.autocrlf on the cloning machine.
*.json text eol=lf

# Immutable imported benchmark sources: hash-pinned (SHA-256 over raw bytes in
# data/provenance.csv + references/PNAS2017_Matsuura/provenance). Never normalise
# line endings, so a fresh checkout reproduces the recorded hashes exactly.
references/PNAS2017_Matsuura/raw/** -text
models/pnas2017_full_reference/original/** -text

# D6 trajectory certificates hash the original bytes, including native logs
# and timestamped preregistrations. Do not normalize this frozen evidence.
docs/audit/nondim_trajectory_20260923/** -text
docs/theory/nondim_map.json -text

# Keep the tested D6 implementation and updated theory text byte-stable.
matlab/src/theory/pure_nondim_map.m text eol=lf
matlab/src/theory/rhs_pure_literature_dimensionless.m text eol=lf
matlab/src/theory/jacobian_pure_literature_dimensionless.m text eol=lf
matlab/src/theory/simulate_pure_literature_dimensionless.m text eol=lf
matlab/tests/test_dimensionless_trajectory_equivalence.m text eol=lf
scripts/run_nondim_trajectory_validation.m text eol=lf
docs/theory/conservation_report.md text eol=lf
docs/theory_notes.md text eol=lf

# Preserve the committed exact-conservation evidence bytes on checkout.
docs/audit/exact_conservation_20260922/** -text

# Reduced D6 numerical evidence and fingerprinted MATLAB sources.
docs/audit/nondimensionalization_validation_20260923/** text eol=lf
matlab/src/theory/pure_dimensionless_invariants.m text eol=lf
matlab/src/theory/reconstruct_pure_exact_reduced_nondim_state.m text eol=lf
matlab/src/theory/rhs_pure_exact_reduced_nondim.m text eol=lf
matlab/src/theory/simulate_pure_exact_reduced_nondim.m text eol=lf
matlab/tests/test_nondimensionalization_validation.m text eol=lf
scripts/export_pure_nondim_map.m text eol=lf
scripts/run_nondimensionalization_validation.m text eol=lf

# V2 keeps historical v1 bytes and preregistered source fingerprints stable.
docs/audit/nondimensionalization_validation_v2_20260923/** text eol=lf
docs/audit/nondimensionalization_validation_v2_20260923/*.zip -text
scripts/diagnose_nondim_reconstruction.m text eol=lf

# D7 new evidence is immutable per run; source fingerprints use LF bytes.
docs/audit/rs_qssa_d7_20260924/** -text
# Native logs/CSV retain MATLAB whitespace and CRLF; review the files directly.
# Treat generated evidence as opaque in Git diffs instead of rewriting its bytes.
docs/audit/rs_qssa_d7_20260924/**/*.txt -diff
docs/audit/rs_qssa_d7_20260924/**/*.csv -diff
models/reductions/rs_qssa/** text eol=lf
matlab/src/theory/*rs*.m text eol=lf
matlab/tests/test_rs_qssa_reduction.m text eol=lf
scripts/run_rs_qssa_validation.m text eol=lf
scripts/export_rs_qssa_parameters.m text eol=lf
scripts/run_all_tests.m text eol=lf
docs/theory/reduction_certificate.md text eol=lf
scripts/build_rs_qssa_audit.py text eol=lf
.gitattributes text eol=lf
